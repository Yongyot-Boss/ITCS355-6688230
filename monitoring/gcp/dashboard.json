{
  "displayName": "ITCS355 Feature drift",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "PSI: temp_c",
        "xyChart": {
          "dataSets": [{
            "plotType": "LINE",
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type = \"custom.googleapis.com/drift.psi.temp_c\" AND resource.type = \"global\"",
                "aggregation": {
                  "alignmentPeriod": "21600s",
                  "perSeriesAligner": "ALIGN_MAX"
                }
              }
            }
          }],
          "yAxis": {"label": "PSI", "scale": "LINEAR"}
        }
      },
      {
        "title": "PSI: vibration_mm_s",
