# ITCS355 Lab 3 — serving image
#
# Pinned after building against this digest on 2026-09-27.
FROM python:3.11-slim@sha256:45a610eb30c258a202b7000414e1ade0c3549cf5ce1ca16c369e0da116d0fa89 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --prefix=/install -r requirements-serve.txt

FROM python:3.11-slim@sha256:45a610eb30c258a202b7000414e1ade0c3549cf5ce1ca16c369e0da116d0fa89 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

EXPOSE 8080
# Provider-specific routes are configured by the adapter (Vertex uses /ready and
# /predict on its Model resource), preserving these provider-neutral service paths.
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
